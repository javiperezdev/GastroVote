# Built application files
*.apk
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/
*.ipr
*.iws

# Kotlin
.kotlin/

# Comment next line if you want to check in your lock files
*.lock

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# OS files
.DS_Store
Thumbs.db

# Keystore files (never commit)
*.jks
*.keystore

# Google Services (uncomment if you use it and don't want to publish it)
# google-services.json

# Proguard folder generated by IntelliJ
proguard/

# Crashlytics
crashlytics-build.properties

# Java heap dumps
*.hprof

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Miscellaneous
*.orig
*.swp
*~

# Capturas de pantalla de la raíz (no forman parte de la app)
/inicio.png
/final.png
